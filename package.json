{
  "name": "ficsit-planner",
  "private": true,
  "version": "0.13.6",
  "description": "Offline production planner for Satisfactory, as an installable web app",
  "license": "GPL-3.0-or-later",
  "homepage": "https://ficsit-planner.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Albis0/ficsit_planner.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "extract": "bun scripts/extract.mjs",
    "extract:codex": "bun scripts/extract-codex.mjs",
    "extract:map": "bun scripts/extract-map.mjs",
    "extract:world": "bun scripts/extract-world.mjs",
    "extract:elevator": "dotnet run --project tools/map-extractor -c Release -- \"C:/Program Files/Epic Games/Satisfactory\" phases src/data/elevator.json",
    "insights": "bun scripts/codex-insights.ts",
    "test": "bun test",
    "icons": "dotnet run --project tools/icon-extractor -c Release -- \"C:/Program Files/Epic Games/Satisfactory\" src/data/icon-manifest.json public/icons 96",
    "icons:codex": "dotnet run --project tools/icon-extractor -c Release -- \"C:/Program Files/Epic Games/Satisfactory\" src/data/codex-icons.json public/icons 96",
    "icons:world": "dotnet run --project tools/icon-extractor -c Release -- \"C:/Program Files/Epic Games/Satisfactory\" src/data/world-icons.json public/icons 96",
    "preview": "vite preview",
    "deploy": "bun scripts/deploy.mjs",
    "deploy:preview": "bun scripts/deploy.mjs --preview",
    "reports": "bun scripts/reports.mjs",
    "db:migrate": "wrangler d1 migrations apply ficsit-reports --remote",
    "pwa-icons": "pwa-assets-generator",
    "check": "biome check . && tsc -p functions",
    "sweep": "bun run build && node e2e/sweep.mjs",
    "visual": "bun run build && node e2e/visual.mjs",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "elkjs": "0.12.0",
    "highs": "^1.15.3",
    "leaflet": "1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "4.138.0"
  }
}
