{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FICSIT Planlayici",
  "version": "0.1.0",
  "identifier": "dev.albis.ficsitplanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "FICSIT Planlayıcı",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#121416",
        "maximized": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
